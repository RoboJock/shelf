rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function nameOk(value) {
      return value is string && value.size() >= 2 && value.size() <= 24;
    }
    function bookOk(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.author is string && data.author.size() > 0 && data.author.size() <= 200
        && data.workKey is string && data.workKey.size() > 0 && data.workKey.size() <= 80
        && (data.year == null || (data.year is int && data.year >= 0 && data.year <= 2100))
        && (data.coverId == null || (data.coverId is int && data.coverId > 0))
        && data.savedAt is int && data.savedAt > 0
        && data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && nameOk(request.resource.data.name)
        && request.resource.data.guest is bool;
      allow delete: if false;

      match /books/{bookId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId && bookOk(request.resource.data);
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}
