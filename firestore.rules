rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function nameOk(value) {
      return value is string && value.size() >= 2 && value.size() <= 24;
    }
    function bookOk(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.author is string && data.author.size() > 0 && data.author.size() <= 200
        && data.workKey is string && data.workKey.size() > 0 && data.workKey.size() <= 80
        && (data.year == null || (data.year is int && data.year >= 0 && data.year <= 2100))
        && (data.coverId == null || (data.coverId is int && data.coverId > 0))
        && data.savedAt is int && data.savedAt > 0
        && data.uid == request.auth.uid
        && (!("description" in data) || data.description == null || (data.description is string && data.description.size() <= 480))
        && (!("pages" in data) || data.pages == null || (data.pages is int && data.pages > 0 && data.pages <= 20000))
        && (!("publisher" in data) || data.publisher == null || (data.publisher is string && data.publisher.size() <= 120))
        && (!("categories" in data) || data.categories == null || (data.categories is string && data.categories.size() <= 80))
        && (!("image" in data) || data.image == null || (data.image is string && data.image.size() <= 300));
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId)
        && nameOk(request.resource.data.name)
        && request.resource.data.guest == false;
      allow delete: if false;

      match /books/{bookId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId) && bookOk(request.resource.data);
        allow delete: if owns(userId);
      }

      match /shelves/{shelfId} {
        allow read: if owns(userId);
        allow create: if owns(userId)
          && request.resource.data.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.createdAt is int;
        allow update: if owns(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if owns(userId);

        match /books/{bookId} {
          allow read: if owns(userId);
          allow create, update: if owns(userId)
            && bookOk(request.resource.data)
            && request.resource.data.shelfId == shelfId;
          allow delete: if owns(userId);
        }
      }
    }
  }
}
