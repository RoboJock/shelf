rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function nameOk(value) {
      return value is string && value.size() >= 2 && value.size() <= 24;
    }
    function bookOk(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.author is string && data.author.size() > 0 && data.author.size() <= 200
        && data.workKey is string && data.workKey.size() > 0 && data.workKey.size() <= 80
        && (data.year == null || (data.year is int && data.year >= 0 && data.year <= 2100))
        && (data.coverId == null || (data.coverId is int && data.coverId > 0))
        && data.savedAt is int && data.savedAt > 0
        && data.uid == request.auth.uid
        && (!("description" in data) || data.description == null || (data.description is string && data.description.size() <= 480))
        && (!("pages" in data) || data.pages == null || (data.pages is int && data.pages > 0 && data.pages <= 20000))
        && (!("publisher" in data) || data.publisher == null || (data.publisher is string && data.publisher.size() <= 120))
        && (!("categories" in data) || data.categories == null || (data.categories is string && data.categories.size() <= 80))
        && (!("image" in data) || data.image == null || (data.image is string && data.image.size() <= 300));
    }

    function viewerRecord(data) {
      return data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 24;
    }
    function isViewer(userId, shelfId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(userId)/shelves/$(shelfId)/viewers/$(request.auth.uid));
    }
    function canView(userId, shelfId) {
      return owns(userId) || isViewer(userId, shelfId);
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId)
        && nameOk(request.resource.data.name)
        && request.resource.data.guest == false;
      allow delete: if false;

      match /books/{bookId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId) && bookOk(request.resource.data);
        allow delete: if owns(userId);
      }

      match /shelves/{shelfId} {
        allow read: if canView(userId, shelfId);
        allow create: if owns(userId)
          && request.resource.data.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.createdAt is int;
        allow update: if owns(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if owns(userId);

        match /books/{bookId} {
          allow read: if canView(userId, shelfId);
          allow create, update: if owns(userId)
            && bookOk(request.resource.data)
            && request.resource.data.shelfId == shelfId;
          allow delete: if owns(userId);
        }

        match /viewers/{viewerId} {
          allow read: if owns(userId);
          allow create, update: if owns(userId)
            && viewerId != userId
            && viewerRecord(request.resource.data);
          allow delete: if owns(userId);
        }
      }
    }

    match /directory/{emailId} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == emailId
        && request.resource.data.uid == request.auth.uid
        && nameOk(request.resource.data.name);
    }

    match /inbox/{viewerUid}/shelves/{shareId} {
      function inboxOk(data) {
        return data.ownerUid == request.auth.uid
          && data.viewerUid == viewerUid
          && data.viewerUid != data.ownerUid
          && data.shelfId is string
          && data.shelfId.size() > 0
          && data.shelfId.size() <= 80
          && data.shelfName is string
          && data.shelfName.size() > 0
          && data.shelfName.size() <= 40
          && data.ownerName is string
          && data.ownerName.size() >= 2
          && data.ownerName.size() <= 24
          && data.sharedAt is int
          && data.sharedAt > 0
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/shelves/$(data.shelfId)/viewers/$(viewerUid));
      }
      allow read: if signedIn() && request.auth.uid == viewerUid;
      allow create: if signedIn() && inboxOk(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.viewerUid == resource.data.viewerUid
        && request.resource.data.shelfId == resource.data.shelfId
        && inboxOk(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
